# Copy thành .env rồi điền key: cp .env.example .env

# LLM: 9Router là model chính; dự phòng theo thứ tự OpenRouter -> NVIDIA -> Gemini -> Groq (Gemini còn làm judge khi eval)
# 9Router chạy trên máy (tên biến không được bắt đầu bằng số). Container api tự đổi localhost thành host.docker.internal
ROUTER9_BASE_URL=http://localhost:20128/v1
ROUTER9_API_KEY=
ROUTER9_MODEL=agy/gemini-3.8-flash-medium
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Tìm kiếm web (tool web_search)
TAVILY_API_KEY=

# Postgres (database phone). Docker compose dùng POSTGRES_PASSWORD cho container phone_db;
# DATABASE_URL dùng khi chạy code trên máy (container api tự đặt DATABASE_URL trỏ tới service postgres)
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/phone

# Qdrant khi chạy trên máy (container api tự ghi đè bằng http://qdrant:6333)
QDRANT_URL=http://localhost:6333

# LangSmith (tùy chọn)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=phone-sales-agent

# Khóa mã hóa số điện thoại, email của khách trong database (pii.py), bắt buộc để đặt hàng. Tạo khóa:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sao lưu khóa: mất khóa là không đọc lại được thông tin khách đã lưu
PII_KEY=

# Email xác nhận đơn hàng (mailer.py). Mặc định gửi vào Mailpit trong docker-compose (xem tại http://localhost:8025,
# không gửi ra Internet; container api tự dùng SMTP_HOST=mailpit). Để trống SMTP_HOST thì không gửi email.
# Chạy thật: Gmail (smtp.gmail.com, 587, STARTTLS=true, App Password) hoặc SES / SendGrid / Resend.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=PhoneShop Demo <no-reply@phoneshop.example>

# Agent service (services/agent, cổng 8001). be gọi agent ở AGENT_URL (compose tự đặt http://agent:8001).
# AGENT_API_KEY: đặt thì agent đòi header "Authorization: Bearer <key>" (be tự gửi); bắt buộc khi mở agent
# cho hệ thống khác tích hợp. Tạo key: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_URL=http://localhost:8001
AGENT_API_KEY=

# Quản trị chính sách ở be: /admin/policies (header "Authorization: Bearer <key>"). Để trống thì tắt.
# Tạo key: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Chống spam ở be: mỗi IP tối đa ngần này lượt /chat, /chat/stream, /session, /order* mỗi phút (0: tắt)
CHAT_RATE_PER_MIN=20
